# Copy to `.env` and fill in your LLM server details.
#
# `SUBSETZER_LLM_SERVER` is the OpenAI-compatible `/v1` root.
#   Ollama:      http://127.0.0.1:11434/v1
#   vLLM:        http://host:8080/v1
#   llama.cpp:   http://host:8080/v1
#   LM Studio:   http://localhost:1234/v1
SUBSETZER_LLM_SERVER=http://127.0.0.1:11434/v1
SUBSETZER_LLM_MODEL=gemma3:12b
SUBSETZER_HTTP_TIMEOUT=60
SUBSETZER_CUES_PER_REQUEST=4

# Optional: server-specific body passthrough, e.g. vLLM's thinking switch.
# SUBSETZER_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# SUBSETZER_MAX_TOKENS=4000
# SUBSETZER_TEMPERATURE=0.2
# SUBSETZER_API_KEY=
